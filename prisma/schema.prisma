generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Trend {
  RISING
  FALLING
  STABLE
}

model Subject {
  id           Int           @id @default(autoincrement())
  firstname    String
  lastname     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  observations Observation[]
}

model Biomarker {
  id        Int      @id @default(autoincrement())
  loincCode String?
  name      String
  longName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biomarkerAllowedUnit BiomarkerAllowedUnit[]
  observations         Observation[]
}

model Unit {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  defaultTargetUnitId Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultTargetUnit    BiomarkerAllowedUnit   @relation(fields: [defaultTargetUnitId], references: [id], name: "DefaultTargetUnit")
  biomarkerAllowedUnit BiomarkerAllowedUnit[]
}

model BiomarkerAllowedUnit {
  id          Int      @id @default(autoincrement())
  biomarkerId Int
  unitId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  biomarker         Biomarker     @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)
  unit              Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  observations      Observation[]
  unitDefaultTarget Unit[]        @relation(name: "DefaultTargetUnit")

  @@unique([biomarkerId, unitId])
}

model Observation {
  id                     Int       @id @default(autoincrement())
  subjectId              Int
  biomarkerAllowedUnitId Int
  analyte                Int
  value                  Float
  measuredAt             DateTime
  rawPayload             Json
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  biomarker            Biomarker            @relation(fields: [analyte], references: [id])
  subject              Subject              @relation(fields: [subjectId], references: [id])
  biomarkerAllowedUnit BiomarkerAllowedUnit @relation(fields: [biomarkerAllowedUnitId], references: [id])
}
