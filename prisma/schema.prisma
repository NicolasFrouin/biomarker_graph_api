generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Trend {
  RISING
  FALLING
  STABLE
}

model Subject {
  id           Int           @id @default(autoincrement())
  firstname    String
  lastname     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  observations Observation[]
}

model Analyte {
  id                  Int      @id @default(autoincrement())
  loincCode           String?
  name                String
  longName            String?
  defaultTargetUnitId Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  defaultTargetUnit  Unit                 @relation(fields: [defaultTargetUnitId], references: [id])
  analyteAllowedUnit AnalyteAllowedUnit[]
  observations       Observation[]

  @@index([loincCode])
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyteAllowedUnits AnalyteAllowedUnit[]
  unitDefaultTarget   Analyte[]

  @@index([name])
}

model AnalyteAllowedUnit {
  id        Int      @id @default(autoincrement())
  analyteId Int
  unitId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyte      Analyte       @relation(fields: [analyteId], references: [id], onDelete: Cascade)
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([analyteId, unitId])
}

model Observation {
  id                   Int       @id @default(autoincrement())
  subjectId            Int
  analyteAllowedUnitId Int
  analyteId            Int
  value                Float
  measuredAt           DateTime
  rawPayload           Json
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  analyte            Analyte            @relation(fields: [analyteId], references: [id])
  subject            Subject            @relation(fields: [subjectId], references: [id])
  analyteAllowedUnit AnalyteAllowedUnit @relation(fields: [analyteAllowedUnitId], references: [id])
}
